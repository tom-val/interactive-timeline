---
import './SmallProjects.css'
import { SMALL_PROJECTS } from '../../data/projects'
import { useTranslations, type SupportedLanguage } from '../../i18n'

interface Props {
    lang: SupportedLanguage
}

const { lang } = Astro.props
const t = useTranslations(lang)

// Flat white icons matching the site's inline-SVG style (Material paths).
const ICON_PATHS: Record<string, string> = {
    heart: 'M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z',
    drink: 'M3 2l2.01 18.23C5.13 21.23 5.97 22 7 22h10c1.03 0 1.87-.77 1.99-1.77L21 2H3zm9 17c-1.66 0-3-1.34-3-3 0-2 3-5.4 3-5.4s3 3.4 3 5.4c0 1.66-1.34 3-3 3zm6.33-11H5.67l-.44-4h13.53l-.43 4z',
}
---

<section class="section">
    <h2 class="section-title">{t('smallProjects.title')}</h2>
    <p class="section-subhead">{t('smallProjects.subhead')}</p>

    <div class="small-grid">
        {
            SMALL_PROJECTS.map((p) => (
                <div class="small-card">
                    <div class={`ico ${p.placeholderClass}`}>
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            width="28"
                            height="28"
                            fill="currentColor"
                            aria-hidden="true"
                        >
                            <path d={ICON_PATHS[p.icon]}></path>
                        </svg>
                    </div>
                    <div>
                        <h4>{t(`smallProjects.${p.id}.title`)}</h4>
                        <p>{t(`smallProjects.${p.id}.desc`)}</p>
                        <a
                            class="small-link"
                            href={p.url}
                            target="_blank"
                            rel="noreferrer"
                        >
                            {new URL(p.url).host} ↗
                        </a>
                    </div>
                </div>
            ))
        }
    </div>
</section>
